{
  "name": "@feedsieve/extension",
  "version": "0.17.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "preview:popup": "vite --config vite.preview.config.mjs",
    "build": "node scripts/copy-runtime-data.mjs && wxt build",
    "build:firefox": "node scripts/copy-runtime-data.mjs && wxt build -b firefox",
    "dev:firefox": "node scripts/copy-runtime-data.mjs && wxt -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "postinstall": "node scripts/copy-runtime-data.mjs && wxt prepare",
    "typecheck": "node scripts/copy-runtime-data.mjs && tsc --noEmit"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@wxt-dev/module-react": "^1.2.2",
    "typescript": "^5.9.3",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "@feedsieve/block-queue": "workspace:*",
    "@feedsieve/community-lists": "workspace:*",
    "@feedsieve/shared": "workspace:*",
    "@feedsieve/detector": "workspace:*",
    "@feedsieve/metrics": "workspace:*",
    "@feedsieve/x-adapter": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
