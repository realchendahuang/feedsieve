// 公开配置：任何 fork/clone 都能按 README 部署自己的实例。
// database_id 是占位符 —— 真实部署配置放在 gitignored 的 wrangler.local.jsonc
// （结构见 wrangler.local.example.jsonc）。密钥一律走 wrangler secret put。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "feedsieve-community-api",
  "main": "src/server.ts",
  "compatibility_date": "2026-08-01",
  // nodejs_compat：nodemailer 走 Workers 出站 socket 直连 SMTP 发验证码
  // （未配置 SMTP_* 时不加载，不影响既有路径）
  "compatibility_flags": ["nodejs_compat"],
  // Cloudflare Email Service 发送绑定加在 gitignored 的 wrangler.local.jsonc
  // （部署侧配置）："send_email": [{ "name": "EMAIL", "remote": true }]。
  // 发信域名需在面板 Email Sending > Onboard Domain；发件地址走 MAIL_FROM。
  // 不放公开配置：remote 绑定会让 vitest 起远程会话，需要账号选择。
  "observability": { "enabled": true },
  // Workers AI / AI Gateway：AI 号判定默认走 Cloudflare 上的 typesafe/jev-1.14.0（第三方模型，
  // 经 AI Gateway 计费，需要账户里有 AI Gateway credits；模型/provider 顺序见 AI_JUDGE_PROVIDERS）。
  // 本地 dev 想直接调 AI 需要给这个 binding 加 "remote": true（会连线上账号，fork 默认不开）。
  "ai": { "binding": "AI" },
  // Workers Cache：公开只读端点（快照 latest / 版本化文件 / 词库）按各自的
  // Cache-Control 在边缘缓存，命中时不再执行 Worker（不碰数据库和 R2）。
  // /api/* 与 /v1/kill-switch 已显式 no-store，不会被共享缓存误命中。
  "cache": { "enabled": true },
  "assets": {
    // 官网 TanStack SSR 与 admin SPA 都靠这一个绑定：vite 构建产物在 dist/client，
    // admin 资产由 scripts/merge-client-assets.mjs 在部署前合并进来。
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // API / OG 图 / SEO 文件与页面（SSR）必须先经 Worker：assets 目录里没有
    // 公示页对应的静态文件，全部路由都从 Worker 出（含 /v1 /api）。
    "run_worker_first": true
  },
  "triggers": {
    "crons": ["0 * * * *", "30 * * * *"],
  },
  // 公开 vars 是 host 门控字符串（非密钥）：本地 dev gates SSR 页面路由，
  // 生产部署的真实值在 wrangler.local.jsonc 覆盖（支持 CSV 多域名）。
  "vars": {
    "SITE_HOST": "feedsieve.win,localhost",
  },
  // PostgreSQL 经 Hyperdrive 接入；关闭缓存，读写都要实时。
  // 本地开发与测试连 docker-compose.yml 的库（localConnectionString）。
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgres://feedsieve:feedsieve_dev_password@127.0.0.1:54330/feedsieve"
    }
  ],
  "r2_buckets": [
    {
      "binding": "KEYWORD_PACKS",
      "bucket_name": "feedsieve-keyword-packs",
    },
  ],
}
