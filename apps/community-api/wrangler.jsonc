// 公开配置：任何 fork/clone 都能按 README 部署自己的实例。
// database_id 是占位符 —— 真实部署配置放在 gitignored 的 wrangler.local.jsonc
// （结构见 wrangler.local.example.jsonc）。密钥一律走 wrangler secret put。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "feedsieve-community-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  // nodejs_compat：nodemailer 走 Workers 出站 socket 直连 SMTP 发验证码
  // （未配置 SMTP_* 时不加载，不影响既有路径）
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Workers Cache：公开只读端点（快照 latest / 版本化文件 / 词库）按各自的
  // Cache-Control 在边缘缓存，命中时不再执行 Worker（不碰 D1/R2）。
  // /api/* 与 /v1/kill-switch 已显式 no-store，不会被共享缓存误命中。
  "cache": { "enabled": true },
  "assets": {
    "directory": "../admin/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "triggers": {
    "crons": ["0 * * * *"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "feedsieve-community",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "KEYWORD_PACKS",
      "bucket_name": "feedsieve-keyword-packs",
    },
  ],
}
