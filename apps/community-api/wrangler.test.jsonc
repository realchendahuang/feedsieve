// 测试专用配置（vitest cloudflare 插件）：main 指向纯 Hono 入口——
// TanStack Start 的 server-entry 是虚拟模块，Miniflare 无法解析；
// 其余绑定与 wrangler.jsonc 保持一致（PostgreSQL 连本地库，R2 用本地模拟）。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "feedsieve-community-api-test",
  "main": "src/api-entry.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": false },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  // 本地 PostgreSQL；实际地址由 vitest.config.ts 的 miniflare.hyperdrives 覆盖（见 test/database-url.ts）
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgres://feedsieve:feedsieve_dev_password@127.0.0.1:54330/feedsieve_test"
    }
  ],
  "r2_buckets": [
    {
      "binding": "KEYWORD_PACKS",
      "bucket_name": "feedsieve-keyword-packs"
    }
  ]
}
