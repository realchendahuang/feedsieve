{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://feedsieve.dev/schema/account-list.schema.json",
  "title": "FeedSieve Final Community Blocklist Snapshot",
  "type": "object",
  "required": ["schema_version", "snapshot_version", "generated_at", "entries"],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "policy_version": {
      "enum": [3, 4]
    },
    "snapshot_version": {
      "type": "string",
      "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}\\.[0-9]{1,4}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "handle",
          "x_user_id",
          "aliases",
          "category",
          "sources",
          "community_score",
          "report_count",
          "rescue_count",
          "net_votes",
          "first_seen_at",
          "updated_at",
          "evidence_post_ids"
        ],
        "properties": {
          "handle": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_]{1,15}$"
          },
          "x_user_id": {
            "type": ["string", "null"],
            "pattern": "^[0-9]+$"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_]{1,15}$"
            },
            "uniqueItems": true
          },
          "category": {
            "type": "string",
            "enum": [
              "bot_spam",
              "copy_paste",
              "ai_slop",
              "advertising",
              "adult_gray_traffic",
              "scam_phishing",
              "engagement_bait",
              "other"
            ]
          },
          "sources": {
            "type": "array",
            "items": {
              "enum": ["community", "maintainer"]
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "maintainer_note": {
            "type": "string",
            "minLength": 4,
            "maxLength": 240
          },
          "community_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "report_count": {
            "type": "integer",
            "minimum": 0
          },
          "rescue_count": {
            "type": "integer",
            "minimum": 0
          },
          "net_votes": {
            "type": "integer"
          },
          "first_seen_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "evidence_post_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9]+$"
            },
            "uniqueItems": true
          },
          "fingerprints": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{16}$"
            },
            "uniqueItems": true,
            "maxItems": 8
          },
          "domains": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"
            },
            "uniqueItems": true,
            "maxItems": 8
          },
          "campaign_entry_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_]{1,15}$"
          },
          "campaign_size": {
            "type": "integer",
            "minimum": 2
          },
          "listed_by": {
            "type": "string",
            "enum": ["corroborated"],
            "description": "只在佐证上榜（净票 ≥ 2 + 多个网段的规则命中佐证，政策 v4）时出现"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "sources": {
                  "contains": {
                    "const": "maintainer"
                  }
                }
              }
            },
            "then": {
              "required": ["maintainer_note"]
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "verified": {
      "type": "array",
      "description": "社区白名单（verified）：被验证为误标正常的账号，入榜公式与黑名单镜像（rescue - report >= 3）。可选字段，旧客户端忽略。",
      "items": {
        "type": "object",
        "required": [
          "handle",
          "x_user_id",
          "rescue_count",
          "report_count",
          "net_votes",
          "first_seen_at",
          "updated_at"
        ],
        "properties": {
          "handle": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_]{1,15}$"
          },
          "x_user_id": {
            "type": ["string", "null"],
            "pattern": "^[0-9]+$"
          },
          "rescue_count": {
            "type": "integer",
            "minimum": 0
          },
          "report_count": {
            "type": "integer",
            "minimum": 0
          },
          "net_votes": {
            "type": "integer",
            "minimum": 3
          },
          "first_seen_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "muted_rules": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9:_-]{0,159}$"
      },
      "description": "误伤率超线已静音的规则 ID（政策 v4），扩展不再用它们标黄框"
    },
    "whitelist": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "维护者推荐白名单"
    },
    "kill_switch": {
      "type": "object",
      "description": "官方破坏性动作暂停开关"
    }
  },
  "additionalProperties": false
}
